  "hints": [
    "Use Breadth-First Search (BFS) with a queue.",
    "Process the queue level by level by recording `level_size = len(queue)` before popping nodes for the current level.",
    "For each node at the current level, record `node['val']`, then append `node['left']` and `node['right']` (if not None) to the queue."
  ],
  "reference_solution": "def level_order_traversal(root: dict | None) -> list:\n    if not root:\n        return []\n    from collections import deque\n    queue = deque([root])\n    result = []\n    while queue:\n        level = []\n        for _ in range(len(queue)):\n            node = queue.popleft()\n            level.append(node['val'])\n            if node.get('left'):\n                queue.append(node['left'])\n            if node.get('right'):\n                queue.append(node['right'])\n        result.append(level)\n    return result\n",
  "time_limit_sec": 3.0
}