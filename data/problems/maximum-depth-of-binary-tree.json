  "hints": [
    "Consider the base case: what is the depth of an empty tree (None)?",
    "Recursively calculate the depth of the left subtree and right subtree.",
    "The maximum depth of the current node is 1 + max(depth(left), depth(right))."
  ],
  "reference_solution": "def max_depth(root: dict | None) -> int:\n    if not root:\n        return 0\n    left_depth = max_depth(root.get('left'))\n    right_depth = max_depth(root.get('right'))\n    return 1 + max(left_depth, right_depth)\n",
