# Local SMTP Configuration for Email Confirmation & Password Reset
# Copy this file to .env and supply your credentials.
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_google_app_password
APP_BASE_URL=http://localhost:8501
